# Parent process container. Runs on the EC2 host (NOT inside the enclave).
# Less stringent measurement requirements than the enclave image.
FROM python:3.15-slim-bookworm@sha256:2a41267d9de9d358f77a1de356e0f16ecba8d39827855be0ce9ef4792edce402

WORKDIR /app
RUN pip install --no-cache-dir uv==0.5.5

COPY pyproject.toml uv.lock ./
COPY src ./src

RUN uv sync --frozen --no-dev

ENV PYTHONPATH=/app/src
ENV PYTHONDONTWRITEBYTECODE=1
EXPOSE 8443

CMD ["/app/.venv/bin/uvicorn", "quill_parent.main:app", "--host", "0.0.0.0", "--port", "8443"]
