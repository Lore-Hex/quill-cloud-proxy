# Build container for the Go enclave EIF.
# Two stages:
#   - builder: pinned golang base, builds a static-PIE binary
#   - runtime: scratch — single binary, no shell, no libc, no /etc/*
# The EIF measurement is a function of the rootfs bytes, so the runtime
# being literally one binary is what makes the PCR0 small + auditable.
#
# REPRODUCIBILITY: the base image is pinned by sha256 digest, not just by
# tag. `golang:1.24-bookworm` is mutable (Docker reuses the tag every
# minor release); the digest pin makes PCR0 stable across rebuilds. To
# update: `docker manifest inspect golang:1.24-bookworm` for the new
# arm64 digest, replace below, expect PCR0 to change, re-publish.
# golang 1.25, matching Dockerfile.enclave.gcp.multi. NOT cosmetic: the
# attest-sidecar module (enclave-go/sidecar/go.mod) requires go 1.25.5, so a
# 1.24 base fails that build step outright. Bumping the base CHANGES PCR0 —
# expected, and the reason this file pins by digest.
FROM golang:1.26-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651 AS builder

# ca-certificates: Go's crypto/tls reads /etc/ssl/certs/ca-certificates.crt at
# runtime to verify TLS peers (Bedrock in our case). The scratch base has no
# trust store, so without this the enclave fails every outbound HTTPS dial
# with "x509: certificate signed by unknown authority".
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# `--platform=linux/<arch>` from `docker buildx build` populates
# TARGETARCH automatically. Default `amd64` so a plain `docker build`
# (no buildx, no --platform) still works for local dev.
#
# AWS deploy: --platform=linux/amd64  (m5.xlarge is x86_64) → amd64
# GCP deploy: --platform=linux/arm64  (Graviton C2 / Pi 5 dev)  → arm64
#
# BUILD_TAGS picks the cloud + provider variant. AWS production uses
# `cloud_aws,llm_multi`. GCP production uses `cloud_gcp,llm_multi`.
ARG TARGETARCH=amd64
ARG BUILD_TAGS=cloud_aws,llm_bedrock
ENV CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH}
RUN go build -trimpath -tags "${BUILD_TAGS}" \
      -ldflags='-s -w -extldflags=-static' \
      -o /out/quill-enclave ./cmd/enclave

# scratch keeps the EIF tiny and the PCR0 surface minimal.
# ─── attest-sidecar binary ──────────────────────────────────────────────────
#
# Lives in its own Go module (enclave-go/sidecar/go.mod) so its heavy dep graph
# stays out of the enclave binary. It is NOT optional: without /attest-sidecar
# the enclave logs
#   attest_sidecar.skipped reason=binary_missing path="/attest-sidecar"
# and exits, which presents as a Nitro enclave that starts, disappears from
# `nitro-cli describe-enclaves`, and leaves parent-pump listening on :8444 with
# nothing behind the vsock. The NLB health check is TCP-level and stays green
# throughout, so nothing surfaces the failure. The GCP multi image already
# builds this; the AWS image did not, which is why AWS attestation had no
# sidecar to answer.
RUN cd sidecar && go mod download \
    && go build -trimpath \
       -ldflags='-s -w -extldflags=-static' \
       -o /out/attest-sidecar .

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/quill-enclave /quill-enclave
COPY --from=builder /out/attest-sidecar /attest-sidecar

# TLS termination INSIDE the enclave — no plaintext prompt content ever
# exists outside this attested binary. With this ENV the enclave wraps its
# vsock listener with crypto/tls; the parent's TCP pump must be paired
# (QUILL_TCP_PUMP=true on parent + NLB doing TCP passthrough at :443).
ENV QUILL_ENCLAVE_TLS=true

# ACME / Let's Encrypt config. Without these the enclave defaults to a
# self-signed cert (CN=api.quillrouter.com, issuer=self) which TLS
# clients reject when CF LB routes them directly to the AWS NLB. Baked
# into the image because:
#   - the AWS image is built specifically for the AWS Nitro deployment
#   - the cert config doesn't vary at runtime
#   - baking puts the config inside the PCR0-measured surface so the
#     attestation document covers it
#
# QUILL_API_HOST is the hostname autocert requests a cert for. Must
# match the hostname the client uses in SNI (api.quillrouter.com — same
# as the public LB host).
#
# QUILL_ACME_CACHE_GCS_BUCKET points the cache at the shared GCS bucket
# every Quill enclave uses. The AWS enclave reads via the cross-cloud
# SA-key path (see internal/enclavetls/gcscache.go's tokenFromSAKey).
#
# QUILL_ACME_EMAIL is per-region so LE's "5 failed validations per
# account per hostname per hour" rate limit is isolated. AWS us-west-2
# gets its own ACME account; a stuck region doesn't poison budget for
# the others.
#
# QUILL_ACME_DIRECTORY_URL is LE production. Leave commented to use
# autocert's default (also LE production) or set explicitly to the LE
# staging endpoint for testing.
# TLS mode is a build ARG, not a hardcoded ENV, because the two deployments of
# this image need different answers:
#
#   - The legacy api.quillrouter.com failover uses ACME (a real LE cert cached
#     in a shared GCS bucket, read via the cross-cloud SA key).
#   - The STANDALONE aws.trustedrouter.com EU deployment must NOT reach back
#     into GCP's ACME cache — that cross-cloud dependency is exactly what the
#     separation architecture removes. It uses SELF-SIGNED, which is correct
#     for a pure-attestation model: the client fetches /attestation over
#     unverified TLS, reads the SEV-SNP-signed document, extracts the attested
#     leaf-cert fingerprint, and pins it. Trust comes from the attestation
#     binding the cert, not from a CA. Self-signed also has ZERO external
#     dependency, so /attestation serves the moment the enclave is up.
#
# Defaults preserve the previous ACME behaviour so nothing else changes.
ARG QUILL_TLS_MODE=acme
ARG QUILL_API_HOST=api.quillrouter.com
ENV QUILL_TLS_MODE=${QUILL_TLS_MODE} \
    QUILL_API_HOST=${QUILL_API_HOST} \
    QUILL_ACME_CACHE_GCS_BUCKET=quill-acme-cache \
    QUILL_ACME_EMAIL=acme-aws-us-west-2@trustedrouter.com

ENTRYPOINT ["/quill-enclave"]
