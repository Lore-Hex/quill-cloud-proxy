# Build container for the GCP Confidential Space target.
# Mirrors Dockerfile.enclave but builds with `-tags 'cloud_gcp,llm_vertex'` to swap the LLM
# provider from AWS Bedrock to Google Vertex AI. The runtime is still
# `FROM scratch` so the workload-image measurement (the OCI digest that
# Confidential Space's vTPM attests) covers exactly one binary + the CA
# bundle.
#
# Architecture is amd64 here — Confidential Space VMs use AMD SEV-SNP
# (and Intel TDX) on x86_64 hosts; AMD-on-ARM Confidential Computing
# isn't a thing yet on GCP. AWS Nitro on Graviton stays arm64; GCP CSP
# stays amd64.

FROM golang:1.26-bookworm@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG SOURCE_REVISION

ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64
RUN go build -trimpath -tags 'cloud_gcp,llm_vertex' -ldflags="-s -w -extldflags=-static -X github.com/Lore-Hex/quill-cloud-proxy/enclave-go/internal/trustedrouter.ShadowBuildRevision=${SOURCE_REVISION}" \
      -o /out/quill-enclave ./cmd/enclave

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/quill-enclave /quill-enclave

# TLS termination INSIDE the workload — same property the AWS target has,
# because Confidential Space VMs don't decrypt either; the workload owns
# the TLS handshake.
ENV QUILL_ENCLAVE_TLS=true
# Dedicated plaintext liveness port for the LB health check (off the TLS :443
# path). Default-on; EXPOSEd so the CS launcher forwards ingress to it.
ENV QUILL_HEALTH_PORT=8081
EXPOSE 8081

# TR_ASYNC_SETTLE_TICKET_PUBLIC_KEYS: JSON {"kid":"issuer~base64url_key"}; empty disables negotiation.
LABEL "tee.launch_policy.allow_env_override"="TR_ASYNC_SETTLE_SHADOW,TR_ASYNC_SETTLE_NEGOTIATE,TR_ASYNC_SETTLE_TICKET_PUBLIC_KEYS,QUILL_BILLING_402_BACKOFF_MS"

ENTRYPOINT ["/quill-enclave"]
