# Polyphemus's local prompt classifier, built once per source change.
#
# The enclave image copies these files from this image by digest, so normal
# deploys neither compile it nor download the weights.
# tools/polyphemus-classifier-image.sh tags it by a hash of
# enclave-go/polyphemus-classifier and this file, and builds it only when
# that tag is missing.
#
# NVIDIA's open weights at a pinned revision, checked here by digest and
# again by the binary's self-test.
FROM rust:1.94.1-alpine@sha256:77237dd363a0b127bb5ef532c2d64c0deb380b738e43a9c4bdac73398d6d0a08 AS build
RUN apk add --no-cache build-base
ADD --checksum=sha256:d9abb6b67d266a712a7f5baea5117bcb8f4be4bec325cf4c7856d35df0fcb953 https://huggingface.co/nvidia/prompt-task-and-complexity-classifier/resolve/fea1121511eafabaf7dd6fc66863dcb04f74defb/model.safetensors /weights/model.safetensors
ADD --checksum=sha256:5124ef2ead1a10a717703bc436de7f353da76d6340e4587719b42b1693707964 https://huggingface.co/nvidia/prompt-task-and-complexity-classifier/resolve/fea1121511eafabaf7dd6fc66863dcb04f74defb/tokenizer.json /weights/tokenizer.json
WORKDIR /src
COPY polyphemus-classifier ./
RUN sh build.sh

FROM scratch
COPY --from=build /out/polyphemus-classifier /polyphemus-classifier
COPY --from=build /out/model/ /polyphemus-classifier-model/
COPY --from=build /src/NOTICE /licenses/polyphemus-classifier-NOTICE.txt
