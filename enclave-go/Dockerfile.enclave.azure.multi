# Multi-provider Azure confidential-container build (AMD SEV-SNP, ACI).
#
# Modelled line for line on Dockerfile.enclave.gcp.multi — same Go toolchain,
# same two binaries, same scratch runtime — with the build tags swapped to
# `cloud_azure,llm_multi` and three Azure-specific differences called out
# below. Keeping the two files structurally parallel is deliberate: they are
# the same workload on different hardware, and a diff between them should show
# only what genuinely differs about the platform.
#
# The image this produces is the thing the CCE policy measures. Every byte of
# it — layers, entrypoint, env — feeds the policy hash that ends up in
# x-ms-sevsnpvm-hostdata and that the Key Vault release policy is bound to. So
# a change here is a change to the enclave's identity: rebuild, regenerate the
# policy, RE-BIND the key, then deploy. tools/deploy-azure-aci.sh enforces that
# order and explains why.

# ─── Builder ────────────────────────────────────────────────────────────────
#
# Same pinned Go 1.26.10 builder as the GCP multi image. The history behind
# pinning it (deploy 25592563258, the sidecar module split) is written up in
# Dockerfile.enclave.gcp.multi and applies unchanged here.
# Build only the MIT client from pinned source, with our bounded control-plane patch.
# ACR's dependency scanner requires legacy-compatible Dockerfile syntax.
# Both stages are native amd64; build.sh verifies the archive before extraction.
FROM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS privatemode
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64
WORKDIR /src
RUN curl --fail --show-error --silent --location --retry 3 --max-time 300 \
    https://codeload.github.com/edgelesssys/privatemode-public/tar.gz/317d813671769c16238b8e93245e5e2e06060a92 \
    -o /tmp/privatemode-source.tar.gz
COPY third_party/privatemode ./third_party/privatemode
RUN bash third_party/privatemode/build.sh /tmp/privatemode-source.tar.gz /out/privatemode-proxy

FROM rust:1.94.1-alpine@sha256:77237dd363a0b127bb5ef532c2d64c0deb380b738e43a9c4bdac73398d6d0a08 AS maple
RUN apk add --no-cache build-base curl patch
WORKDIR /src
COPY maple-transport ./
RUN sh build.sh

FROM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && sed -i -e 's|^mozilla/emSign_ECC_Root_CA_-_G3.crt$|!&|' \
              -e 's|^mozilla/Comodo_AAA_Services_root.crt$|!&|' /etc/ca-certificates.conf \
    && update-ca-certificates --fresh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# ─── Main enclave binary ────────────────────────────────────────────────────
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG SOURCE_REVISION

# GOARCH=amd64 is not a default, it is a hardware requirement: AMD SEV-SNP is
# x86-64 only, and Azure confidential containers run nowhere else. It is also
# what keeps the image SINGLE-ARCH, which `az confcom acipolicygen` requires —
# Docker's containerd image store reports platform "/" for a multi-arch
# manifest and confcom refuses to generate a policy for it.
ENV CGO_ENABLED=0 GOOS=linux GOARCH=amd64
RUN go build -trimpath -tags 'cloud_azure,llm_multi' \
      -ldflags="-s -w -extldflags=-static -X github.com/Lore-Hex/quill-cloud-proxy/enclave-go/internal/trustedrouter.ShadowBuildRevision=${SOURCE_REVISION}" \
      -o /out/quill-enclave ./cmd/enclave

# ─── attest-sidecar binary ──────────────────────────────────────────────────
#
# Separate Go module (enclave-go/sidecar/go.mod) so its sigstore/go-tuf/CT dep
# tree is never linked into /quill-enclave. Included on Azure for the same
# reason as on GCP: the llm_multi build serves tinfoil, and tinfoil traffic is
# verified against an AMD-signed attestation the sidecar produces. Its absence
# is non-fatal (main.go logs attest_sidecar.skipped and serves in raw-only
# mode), but shipping it keeps the Azure and GCP fleets behaviourally identical.
RUN cd sidecar && go mod download \
    && go build -trimpath \
       -ldflags='-s -w -extldflags=-static' \
       -o /out/attest-sidecar .

# ─── /tmp ────────────────────────────────────────────────────────────────────
#
# Azure no longer writes or accepts a GCP credential. Keep a conventional
# scratch-image /tmp for bounded runtime scratch data and diagnostics, but it
# is not a cross-cloud credential path.
#
# Mode 1777 matches a normal /tmp, and getting it into the IMAGE takes the
# staging directory below rather than the obvious one-liner. `COPY <dir> <dest>`
# copies the CONTENTS of <dir>, so `COPY /out/tmp /tmp` creates /tmp implicitly
# with default 0755 and drops the chmod on the floor — the built layer really
# does contain `drwxr-xr-x 0/0 tmp/`, verifiable with `docker save | tar -tv`.
# `--chmod` does not help either: it applies to the entries being copied, not to
# a destination the copy invents.
#
# Copying the PARENT (`/out/rootfs/` -> `/`) makes tmp/ an entry that is itself
# copied, so its mode survives. Nothing on this image runs as a non-root user
# today, so 1777 is defence in depth rather than a live requirement — but a
# comment claiming a mode the image does not have is the kind of thing the next
# person builds on.
RUN mkdir -p /out/rootfs/tmp && chmod 1777 /out/rootfs/tmp

# ─── Scratch runtime, both binaries ─────────────────────────────────────────
FROM scratch
COPY --from=maple /out/maple-transport /maple-transport
COPY --from=maple /src/MAPLE-LICENSE /licenses/maple-MIT.txt
COPY --from=privatemode /out/privatemode-proxy /privatemode-proxy
COPY --from=privatemode /out/privatemode-proxy.LICENSE /licenses/privatemode-MIT.txt
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/rootfs/ /
COPY --from=builder /out/quill-enclave /quill-enclave
COPY --from=builder /out/attest-sidecar /attest-sidecar

ENV QUILL_ENCLAVE_TLS=true
ENV QUILL_TLS_MODE=acme
# Plaintext liveness port for operator checks, off the TLS :443 path. Same
# default as the GCP image. Nothing health-checks it on Azure either: ACI has
# no attesting health probe, so fleet membership is the DNS reconciler's
# attestation, exactly as on GCP.
ENV QUILL_HEALTH_PORT=8081

EXPOSE 443
EXPOSE 8081

# NO `tee.launch_policy.allow_env_override` label.
#
# That label is Confidential Space's mechanism for deciding which env vars a
# deploy may set on an attested workload. Azure has no equivalent and needs
# none: on ACI the container group's ENTIRE env-var set is an input to the CCE
# policy, so every name AND value is measured into the policy hash, into
# x-ms-sevsnpvm-hostdata, and thus into the Key Vault release policy the key is
# bound to. Changing one env var changes the measurement and the enclave gets a
# 403 from Key Vault instead of booting. An allow-list would be strictly weaker
# than what the platform already enforces, and pretending it did something here
# would be worse than omitting it.
#
# The env this image reads, for operators reading the image rather than the
# deploy script (tools/deploy-azure-aci.sh is the source of truth):
#
#   Azure boot:   QUILL_AZURE_MAA_ENDPOINT, QUILL_AZURE_AKV_ENDPOINT,
#                 QUILL_AZURE_SKR_KEY_ID, QUILL_AZURE_BUNDLE_SECRET,
#                 QUILL_AZURE_ACME_CACHE_KEY_SECRET (all required, no defaults)
#                 QUILL_AZURE_BUNDLE_VERSION, QUILL_AZURE_MI_CLIENT_ID,
#                 QUILL_AZURE_SKR_URL, QUILL_AZURE_REGION,
#                 QUILL_AZURE_ATTESTATION_URL (optional)
#   Secret names: QUILL_GCP_PROJECT_ID, QUILL_DEVICE_KEYS_SECRET,
#                 QUILL_*_SECRET (the binding table in
#                 internal/bootstrap/secrets.go)
#   Serving:      QUILL_API_HOST, QUILL_TLS_MODE, QUILL_ACME_EMAIL,
#                 QUILL_AZURE_ACME_STORAGE_ACCOUNT,
#                 QUILL_AZURE_ACME_STORAGE_CONTAINER, QUILL_HEALTH_PORT,
#                 QUILL_FIRST_BYTE_TIMEOUT_SECONDS, TR_CONTROL_PLANE_BASE_URL

ENTRYPOINT ["/quill-enclave"]
